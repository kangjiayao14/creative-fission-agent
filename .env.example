# ═══════════════════════════════════════════════════════════════════════════
#  裂变引擎 · Creative Fission Agent —— 环境变量
#  复制本文件为 .env.local (本地) 或填入 Vercel 项目的 Environment Variables
# ═══════════════════════════════════════════════════════════════════════════

# ── 智谱 GLM API Key ─────────────────────────────────────────────────────────
# 获取:https://open.bigmodel.cn/  →  API Keys
#
# ⚠️ 本文件是【模板】,Next.js 不会读取它!请勿在这里填真实 Key(会被提交到 git)。
#   正确做法二选一:
#   1)BYOK 模式(默认):访客在网页右上角填写自己的 Key,服务器无需配置;
#   2)免费公开模式:在部署环境配置本变量,由服务器承担调用额度。
ZHIPU_API_KEY=

# ── 访问控制 ─────────────────────────────────────────────────────────────────
# 安全默认值为 byok。仅在你愿意承担所有访客调用成本时改为 free。
SITE_RUN_MODE=byok

# 站长控制台密码。必须在部署平台生成强随机值,禁止提交真实密码。
SITE_ADMIN_PASSWORD=

# ── 可选:接口地址(一般无需修改)────────────────────────────────────────────
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ── 可选:模型覆盖(默认已是最新的 GLM-5.3-Flash + glm-image)──────────────────
# GLM-5.3-Flash 原生多模态(文本+视觉+视频),支持 1M 上下文,故文本与视觉共用它。
GLM_TEXT_MODEL=glm-5.3-flash
GLM_VISION_MODEL=glm-5.3-flash
GLM_IMAGE_MODEL=glm-image

# ═══════════════════════════════════════════════════════════════════════════
#  应用调用的智谱接口一览(供参考,无需填写):
#
#  1) 文本 / 多模态理解  POST {ZHIPU_BASE_URL}/chat/completions   model=glm-5.3-flash
#     用途:基因测序(读图)、策略变异、Loop 质检
#     参数:thinking.type=enabled, temperature, top_p=0.95, reasoning_effort
#
#  2) 文生图            POST {ZHIPU_BASE_URL}/images/generations  model=glm-image
#     用途:根据创意假设生成全新图片素材
#     参数:prompt, size (如 1024x1024 / 1280x1280)
#
#  本应用自身暴露的 API 路由(前端 → 后端):
#     POST /api/sequence   原始素材 → 创意基因组         (调用 glm-5.3-flash 读图)
#     POST /api/mutate     基因组 → N 条创意假设          (调用 glm-5.3-flash)
#     POST /api/generate   假设 imagePrompt → 新图片素材  (调用 glm-image)
#     POST /api/qa         生成素材 → 五维质检 + 修复批注  (调用 glm-5.3-flash 读图)
#     四个路由都从请求头 x-zhipu-key 或本环境变量 ZHIPU_API_KEY 读取密钥。
# ═══════════════════════════════════════════════════════════════════════════
