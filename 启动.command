#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# 裂变引擎 · 双击即启动(macOS)
#
# 使用方法:在「访达 Finder」里【双击本文件】即可。
#   - 会自动打开终端、安装依赖(首次)、释放端口、启动本地服务
#   - 启动成功后会自动用默认浏览器打开 http://localhost:3000
#   - 想停止服务:回到这个终端窗口按 Control + C
#
# 若双击提示“无法打开,因为来自身份不明的开发者”:
#   右键本文件 → 打开 → 再点“打开”;或在终端执行一次 chmod +x 启动.command
# ─────────────────────────────────────────────────────────────────────────────
cd "$(dirname "$0")"

echo "▶ 正在启动『裂变引擎』本地服务,请稍候…"

# 启动后台等待:等服务真正起来了(3000 端口能访问)再打开浏览器
(
  for i in $(seq 1 60); do
    if curl -s -o /dev/null "http://localhost:3000"; then
      open "http://localhost:3000"
      break
    fi
    sleep 1
  done
) &

# 前台跑启动脚本(dev 模式);日志会实时打印在这个终端窗口里
bash ./start.sh
